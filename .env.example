# Postgres (Railway provides this automatically as DATABASE_URL when you add a Postgres plugin)
DATABASE_URL=postgres://user:password@localhost:5432/leakradar

# Reddit API — create an app at https://www.reddit.com/prefs/apps (type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=leak-radar/0.1 by yourusername

# Subreddits to monitor, comma-separated
REDDIT_SUBREDDITS=GTA6,GTA,leaks,GTAV

# RSS/Atom feeds to poll — no API key needed. Comma-separated URLs.
# Leave unset to use the built-in default list (see src/ingest/rss.js).
# Add YouTube channel upload feeds like:
# https://www.youtube.com/feeds/videos.xml?channel_id=CHANNEL_ID
RSS_FEEDS=

# Twitter/X ingestion via twitterapi.io (https://twitterapi.io) — no OAuth, just an API key.
# Sign up, get a key, paste it here.
TWITTERAPI_IO_KEY=
# Optional: override the default advanced-search query (see src/ingest/twitter.js for the default)
TWITTER_SEARCH_QUERY=

# Salt used to hash visitor IPs before storing them for vote de-duplication.
# Set this to any random string — it just needs to stay consistent so the same
# visitor hashes to the same value across requests. Never store raw IPs.
IP_HASH_SALT=

# How often to run ingestion (cron syntax), only used if running src/index.js as a long-lived process
INGEST_CRON=*/10 * * * *

# API server port
PORT=3000
